# Public origin of this forgit instance. No trailing slash.
APP_URL=http://localhost:3000

# Signs Better Auth cookies. Required in production. At least 32 characters.
BETTER_AUTH_SECRET=

# Shared with the walgit container. The worker presents this bearer and sets
# X-Walgit-Principal to the end user. The merge helper uses the same token
# with principal svc:forgit-merge.
WALGIT_TOKEN_FORGIT=

# Authenticates the worker to the in-container merge helper.
MERGE_INTERNAL_TOKEN=

# Direct walgit origin for local development (nginx listener).
# In production the worker uses the Cloudflare Container binding instead.
WALGIT_URL=http://127.0.0.1:8080

# R2 S3 credentials. In production these are worker secrets. GitContainer
# forwards them to walgit as AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# R2_ENDPOINT is a wrangler var: https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
