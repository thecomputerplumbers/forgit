{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv worker-env.d.ts",
    "init": "node scripts/init.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/sso": "1.7.5",
    "@cloudflare/containers": "^0.0.31",
    "@forgit/actions": "workspace:*",
    "@forgit/auth": "workspace:*",
    "@forgit/db": "workspace:*",
    "@forgit/domain": "workspace:*",
    "@forgit/git-client": "workspace:*",
    "@forgit/github-compat": "workspace:*",
    "@forgit/mcp": "workspace:*",
    "@forgit/observability": "workspace:*",
    "@vinext/cloudflare": "1.0.0-beta.8",
    "better-auth": "^1.7.5",
    "drizzle-orm": "1.0.0-rc.4",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vinext": "1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/workers-types": "5.20260930.2",
    "@forgit/typescript-config": "workspace:*",
    "@types/hast": "^3.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.145.0"
  }
